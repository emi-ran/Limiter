<Window x:Class="Limiter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limiter 0.13" Height="820" Width="1320" MinWidth="1100" MinHeight="650" Background="#222222" Foreground="#E6E8EB" FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E6E8EB"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#168BD2"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E8EB"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0"/><Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ViewTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E6E8EB"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Tab" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="#454545"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="Background" Value="#C4DF20"/><Setter Property="Foreground" Value="#171717"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#222222"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#44484F"/><Setter Property="Padding" Value="8"/></Style>
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#50555E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Handle" Background="{TemplateBinding Background}" CornerRadius="4" Margin="3,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="#737B86"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="#73BAEA"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton><RepeatButton x:Name="PageBefore" Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb x:Name="Handle" Style="{StaticResource ScrollThumb}" MinHeight="28"/></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton x:Name="PageAfter" Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Handle" Property="Opacity" Value="0"/></Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="Handle" Property="MinHeight" Value="0"/>
                                <Setter TargetName="Handle" Property="MinWidth" Value="28"/>
                                <Setter TargetName="PageBefore" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                                <Setter TargetName="PageAfter" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="#222222"/><Setter Property="Foreground" Value="#E6E8EB"/><Setter Property="RowBackground" Value="#222222"/><Setter Property="AlternatingRowBackground" Value="#222222"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/></Style>
        <Style x:Key="HeaderGrip" TargetType="Thumb">
            <Setter Property="Width" Value="5"/><Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#303030"/><Setter Property="Foreground" Value="#DDE1E5"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ToolTip" Value="Sıralamak için tıklayın. Tekrar tıklayınca artan / azalan yön değişir."/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader">
                <Grid>
                    <Border x:Name="HeaderSurface" Background="{TemplateBinding Background}" BorderBrush="#454545" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Left"/>
                                <TextBlock x:Name="HeaderHint" Text="Uygulama adı" Foreground="#8F969D" FontSize="10" FontWeight="Normal" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="SortArrow" Grid.Column="1" Text="↕" Foreground="#777E85" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <Border x:Name="ActiveLine" Height="2" Background="#00A8E8" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                    <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource HeaderGrip}"/>
                    <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource HeaderGrip}"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="HeaderHint" Property="Visibility" Value="Collapsed"/><Setter TargetName="SortArrow" Property="Visibility" Value="Collapsed"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="#3B3B3B"/></Trigger>
                    <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="İndirme"><Setter TargetName="HeaderHint" Property="Text" Value="3 sn · /sn"/></DataTrigger>
                    <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Yükleme"><Setter TargetName="HeaderHint" Property="Text" Value="3 sn · /sn"/></DataTrigger>
                    <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Toplam"><Setter TargetName="HeaderHint" Property="Text" Value="Oturum trafiği"/></DataTrigger>
                    <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Hız sınırı"><Setter TargetName="HeaderHint" Property="Text" Value="KB/sn"/></DataTrigger>
                    <Trigger Property="SortDirection" Value="Ascending">
                        <Setter TargetName="SortArrow" Property="Text" Value="↑"/><Setter TargetName="SortArrow" Property="Foreground" Value="#56C9F5"/>
                        <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible"/><Setter TargetName="HeaderSurface" Property="Background" Value="#263A43"/>
                        <Setter Property="Foreground" Value="#56C9F5"/>
                    </Trigger>
                    <Trigger Property="SortDirection" Value="Descending">
                        <Setter TargetName="SortArrow" Property="Text" Value="↓"/><Setter TargetName="SortArrow" Property="Foreground" Value="#56C9F5"/>
                        <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible"/><Setter TargetName="HeaderSurface" Property="Background" Value="#263A43"/>
                        <Setter Property="Foreground" Value="#56C9F5"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E6E8EB"/>
            <Setter Property="Padding" Value="4,2"/><Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#00A8E8"/><Setter Property="Foreground" Value="White"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="#E6E8EB"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#00A8E8"/><Setter Property="Foreground" Value="White"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="#222222">
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Border Background="#292929" BorderBrush="#454545" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="MachineName" Foreground="#C4DF20" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Units" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border BorderBrush="#505050" BorderThickness="1" Padding="10,5" Margin="0,0,14,0"><TextBlock Text="autoByte" ToolTip="Hızlar otomatik KB/sn veya MB/sn olarak gösterilir."/></Border>
                    <CheckBox Content="Blocker On" IsEnabled="False" IsChecked="False" ToolTip="Blocker henüz kullanıma açık değil."/>
                    <CheckBox x:Name="LimiterToggle" Content="Limiter On" IsChecked="True" Click="LimiterToggle_Click" ToolTip="Tüm uygulama ve PID hız sınırlarını aç / kapat. Kayıtlı kurallar korunur."/>
                    <CheckBox Content="Priorities On" IsEnabled="False" IsChecked="False" ToolTip="Priorities sonraki aşamada eklenecek."/>
                </StackPanel>
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Height="34" Padding="30,7,8,7" TextChanged="SearchBox_TextChanged" ToolTip="Uygulama adı veya dosya yoluyla ara"/>
                    <TextBlock Text="⌕" FontSize="21" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#91979F"/>
                    <TextBlock Text="Uygulama ara" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#91979F">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="600"/><ColumnDefinition Width="5"/><ColumnDefinition Width="370" MinWidth="300"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="46"/><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#383838" BorderBrush="#C4DF20" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ActivityView" Content="Activity" GroupName="View" IsChecked="True" Style="{StaticResource ViewTab}" Checked="View_Click"/>
                        <RadioButton x:Name="RulesView" Content="Rule List" GroupName="View" Style="{StaticResource ViewTab}" Checked="View_Click" ToolTip="Yalnızca hız sınırı tanımlı satırları göster"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" BorderBrush="#454545" BorderThickness="0,0,0,1" Padding="12,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Bilgisayar trafiği" FontWeight="SemiBold"/><TextBlock x:Name="AppCount" Text="0 uygulama" Foreground="#9298A1" FontSize="10"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,20,0" VerticalAlignment="Center"><TextBlock Text="↓ " Foreground="#8CCB78"/><TextBlock x:Name="TotalDownload" Text="0 KB/sn" Width="95"/></StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="↑ " Foreground="#73BAEA"/><TextBlock x:Name="TotalUpload" Text="0 KB/sn" Width="95"/></StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="#252525" Padding="12,0" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock Text="Başlığa tıklayarak değiştir" Foreground="#858D94" FontSize="10" DockPanel.Dock="Right"/>
                        <TextBlock x:Name="SortDescription" Text="↓  İndirme · Yüksekten düşüğe" Foreground="#56C9F5" FontSize="11"/>
                    </DockPanel>
                </Border>
        <DataGrid x:Name="AppsGrid" Grid.Row="3" SelectionChanged="AppsGrid_SelectionChanged" Sorting="AppsGrid_Sorting" AlternationCount="2" ScrollViewer.VerticalScrollBarVisibility="Visible" SelectionUnit="FullRow" CanUserResizeRows="False" CanUserReorderColumns="False" ColumnHeaderHeight="56">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#00A8E8"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#00A8E8"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Uygulama" SortMemberPath="Name" CanUserSort="True" Width="2.3*" MinWidth="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="6,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Margin="{Binding Indent}"/>
                                <Button Grid.Column="1" Content="{Binding ExpandGlyph}" Click="Expand_Click" Padding="0" Background="Transparent" Foreground="#B8BEC6" ToolTip="Process'leri göster / gizle" Focusable="False">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding CanExpand}" Value="False"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                </Button>
                                <Image Grid.Column="2" Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Grid.Column="3" Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="İndirme" Binding="{Binding DownloadText}" SortMemberPath="DownloadRate" Width="*" MinWidth="125"/>
                <DataGridTextColumn Header="Yükleme" Binding="{Binding UploadText}" SortMemberPath="UploadRate" Width="*" MinWidth="125"/>
                <DataGridTextColumn Header="Toplam" Binding="{Binding TotalText}" SortMemberPath="TotalBytes" Width="0.8*" MinWidth="110"/>
                <DataGridTextColumn Header="Hız sınırı" Binding="{Binding LimitText}" SortMemberPath="DownloadLimit" Width="*" MinWidth="125"/>
            </DataGrid.Columns>
        </DataGrid>
            </Grid>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#454545" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#383838" Padding="14,8"><TextBlock Text="Info View"/></Border>
            <Border Grid.Row="1" Background="#222222" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Application" Foreground="#00A8E8" FontSize="18" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="{Binding SelectedItem.Icon, ElementName=AppsGrid}" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=AppsGrid}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style>
                        </Image>
                        <TextBlock x:Name="SelectedName" Grid.Column="1" Text="Uygulama seçin" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Grid>
                    <TextBlock x:Name="SelectedPath" Text="Listeden bir uygulama seçin." Foreground="#9298A1" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,7,0,16"/>
                    <Border Background="#222222" CornerRadius="1" Padding="12,10" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                            <TextBlock Text="↓ İndirme" Foreground="#8CCB78"/><TextBlock x:Name="SelectedDownload" Grid.Column="1" Text="—"/>
                            <TextBlock Grid.Row="1" Text="↑ Yükleme" Foreground="#73BAEA"/><TextBlock x:Name="SelectedUpload" Grid.Row="1" Grid.Column="1" Text="—"/>
                            <TextBlock Grid.Row="2" Text="Toplam trafik" Foreground="#9298A1"/><TextBlock x:Name="SelectedTotal" Grid.Row="2" Grid.Column="1" Text="—"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Rules · Hız sınırları" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="SelectedRule" Text="—" Foreground="#73BAEA" Margin="0,0,0,8"/>
                    <TextBlock x:Name="RuleScope" Text="Kural kapsamı seçilen satıra göre belirlenir." Foreground="#9298A1" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ParentRule" Text="" Foreground="#D9B97F" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <StackPanel x:Name="RuleControls" IsEnabled="False">
                        <TextBlock Text="İndirme · KB/sn" Foreground="#B8BEC6" Margin="0,0,0,5"/><TextBox x:Name="DownloadBox" Text="0" Margin="0,0,0,12"/>
                        <TextBlock Text="Yükleme · KB/sn" Foreground="#B8BEC6" Margin="0,0,0,5"/><TextBox x:Name="UploadBox" Text="0" Margin="0,0,0,10"/>
                        <TextBlock Text="0 = bu kapsamda sınır yok · En az 16 KB/sn" Foreground="#9298A1" FontSize="11" Margin="0,0,0,14"/>
                        <Button Content="Uygula" Click="Save_Click"/>
                        <Button Content="Sınırları kaldır" Click="ClearLimits_Click" Background="#454545" Margin="0,8,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="RuleMessage" Foreground="#8CCB78" Margin="0,10,0,0" TextWrapping="Wrap">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#292929" BorderBrush="#454545" BorderThickness="0,1,0,0" Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock x:Name="LimiterState" Text="Sınırlar etkin" Foreground="#C4DF20" FontSize="11" DockPanel.Dock="Right" Margin="20,0,0,0"/>
                <TextBlock Text="3 sn ortalama · KB = 1024 bayt" Foreground="#9298A1" FontSize="10" DockPanel.Dock="Right"/>
                <TextBlock x:Name="StatusText" Text="Başlatılıyor..." Foreground="#9298A1" FontSize="10" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
